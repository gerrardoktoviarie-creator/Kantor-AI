# Salin jadi .env, terus isi yang perlu. Yang kosong boleh dibiarin.

# Port aplikasi.
PORT=4100

# 127.0.0.1 = cuma bisa dibuka dari komputer ini (aman, gak perlu password).
# Di VPS: HOST=0.0.0.0, isi KANTOR_PASSWORD, dan PUBLIC_URL alamat yang diketik di browser.
HOST=127.0.0.1
KANTOR_PASSWORD=
PUBLIC_URL=

# Otak AI: endpoint yang kompatibel OpenAI (9router, OpenRouter, dll).
LLM_URL=http://localhost:20128/v1
LLM_MODEL=code
LLM_KEY=

# Google Classroom (divisi Tugas). Cara bikin ada di halaman Tugas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bot Telegram sendiri dari @BotFather. Kalau pakai Hermes, ini boleh kosong:
# pilih "Pakai bot Hermes" di halaman Tugas.
TELEGRAM_BOT_TOKEN=

# Lokasi buat jadwal salat. Default Jakarta (WIB = 7, WITA = 8, WIT = 9).
PRAYER_CITY=Jakarta
PRAYER_LAT=-6.2088
PRAYER_LON=106.8456
PRAYER_UTC_OFFSET=7

# Opsional.
# FFMPEG_PATH=
# WHISPER_MODEL=
# HERMES_HOME=
